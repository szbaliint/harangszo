{
  "_about": "Harangszó tokens for the map-first layout (light theme). Roles follow the replica template; values are Harangszó's own palette, not the reference app's. The live source of truth is the :root block in styles.css; tokens.css mirrors it. Dark theme: tokens.dark.json.",
  "color": {
    "bg": "#eef0f3",
    "surface": "#ffffff",
    "glass": "#f7f8fa",
    "border": "#d3d8e0",
    "border-input": "#7b8496",
    "text": "#141a26",
    "text-muted": "#4a5468",
    "text-faint": "#5f687b",
    "accent": "#23408e",
    "on-accent": "#ffffff",
    "penance": "#6a2e8c",
    "on-penance": "#ffffff",
    "gold": "#8a5f0c",
    "open": "#1d7a4c",
    "danger": "#a2361f",
    "marker-none-text": "#4a5468",
    "marker-none-bg": "#ffffff",
    "accent-soft": "#e3e8f6"
  },
  "pairs": [
    ["text", "bg"], ["text", "surface"], ["text", "glass"],
    ["text-muted", "surface"], ["text-muted", "glass"], ["text-faint", "surface"], ["text-faint", "glass"],
    ["on-accent", "accent"], ["on-penance", "penance"], ["accent", "glass"], ["accent", "accent-soft"],
    ["gold", "glass"], ["open", "glass"], ["danger", "surface"],
    ["marker-none-text", "marker-none-bg"],
    ["border-input", "surface", "ui"], ["accent", "surface", "ui"]
  ],
  "font": {
    "display": "Spectral, Georgia, serif",
    "sans": "IBM Plex Sans, system-ui, -apple-system, Segoe UI, sans-serif",
    "mono": "IBM Plex Mono, ui-monospace, Menlo, monospace"
  },
  "type": {
    "micro": {"size": 11, "line": 14, "weight": 600, "note": "mono caps, letter-spacing .12em"},
    "xs": {"size": 12, "line": 16, "weight": 500},
    "sm": {"size": 14, "line": 20, "weight": 400},
    "base": {"size": 15, "line": 22, "weight": 400},
    "lg": {"size": 18, "line": 24, "weight": 600},
    "xl": {"size": 26, "line": 30, "weight": 700},
    "hero-time": {"size": 40, "line": 40, "weight": 600, "note": "mono, next Mass time in the sheet"}
  },
  "space": [0, 4, 8, 12, 16, 24, 32, 48],
  "radius": {"sm": 8, "md": 14, "lg": 22, "sheet": 24, "pill": 999},
  "shadow": {
    "float": "0 6px 24px rgb(0 0 0 / .18), 0 1px 3px rgb(0 0 0 / .12)",
    "sheet": "0 -8px 32px rgb(0 0 0 / .22)"
  },
  "glass": {"alpha": 0.86, "blur": "14px"},
  "motion": {"fast": "120ms", "base": "220ms", "sheet": "320ms", "ease": "cubic-bezier(.2,.8,.2,1)"},
  "layout": {"tabbar-height": 60, "float-gap": 12, "desktop-panel": 400, "breakpoint": 900, "marker-label-zoom": 13}
}
